{% extends 'base.html.twig' %}
{% block title %}Réservation confirmée{% endblock %}

{% block body %}
<div class="container py-5 text-center" style="max-width:700px">
    <div class="mb-4">
        <div style="width:90px;height:90px;background:rgba(25,135,84,.15);border:2px solid #198754;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem">
            <i class="fas fa-check fa-2x" style="color:#198754"></i>
        </div>
        <h1 style="font-family:'Playfair Display',serif;font-size:2rem">Réservation Confirmée !</h1>
        <p class="text-muted">Votre voyage est réservé avec succès.</p>
    </div>

    <div style="background:var(--dark-card);border:1px solid var(--border-color);border-radius:12px;padding:2rem;text-align:left;margin-bottom:2rem">
        <div class="row g-3">
            <div class="col-6">
                <div class="text-muted small text-uppercase" style="letter-spacing:.5px">Référence</div>
                <div class="text-gold fw-bold fs-5">{{ reservation.reference }}</div>
            </div>
            <div class="col-6">
                <div class="text-muted small text-uppercase" style="letter-spacing:.5px">Statut</div>
                <span class="badge badge-success px-3 py-2">Confirmée</span>
            </div>
            <div class="col-12"><hr class="divider-gold"></div>
            <div class="col-6">
                <div class="text-muted small">Voyage</div>
                <div>{{ reservation.voyage.titre }}</div>
            </div>
            <div class="col-6">
                <div class="text-muted small">Destination</div>
                <div>{{ reservation.voyage.destination.nom }}</div>
            </div>
            <div class="col-6">
                <div class="text-muted small">Départ</div>
                <div>{{ reservation.voyage.dateDepart|date('d/m/Y') }}</div>
            </div>
            <div class="col-6">
                <div class="text-muted small">Retour</div>
                <div>{{ reservation.voyage.dateRetour|date('d/m/Y') }}</div>
            </div>
            {% if reservation.hotel %}
            <div class="col-6">
                <div class="text-muted small">Hôtel</div>
                <div>{{ reservation.hotel.nom }} ({{ reservation.nombreNuits }} nuits)</div>
            </div>
            {% endif %}
            {% if reservation.chauffeur %}
            <div class="col-6">
                <div class="text-muted small">Chauffeur</div>
                <div>{{ reservation.chauffeur.nomComplet }}</div>
            </div>
            {% endif %}
            <div class="col-12"><hr class="divider-gold"></div>
            {% if reservation.voucher %}
            <div class="col-12 d-flex justify-content-between align-items-center small">
                <span class="text-muted"><i class="fas fa-ticket-alt text-gold me-1"></i>Voucher {{ reservation.voucher.code }} (-{{ reservation.voucher.pourcentage }} %)</span>
                <span style="color:#198754">-{{ reservation.montantRemise|number_format(2, ',', ' ') }} €</span>
            </div>
            {% endif %}
            <div class="col-12 d-flex justify-content-between align-items-center">
                <span class="fw-bold">Total payé</span>
                <span class="text-gold fw-bold" style="font-size:1.4rem;font-family:'Playfair Display',serif">
                    {{ reservation.prixTotal|number_format(2, ',', ' ') }} €
                </span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3 justify-content-center flex-wrap">
        {% if voucherEligible %}
        <a href="{{ path('profil_voucher') }}" class="btn-gold" target="_blank" style="padding:.85rem 2rem">
            <i class="fas fa-ticket-alt me-2"></i>Télécharger voucher
        </a>
        {% endif %}
        <a href="{{ path('profil_reservations') }}" class="btn-outline-gold" style="padding:.85rem 2rem">
            <i class="fas fa-list me-2"></i>Mes réservations
        </a>
    </div>
</div>
{% endblock %}
