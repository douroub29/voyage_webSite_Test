{# Widget chatbot DreamTravel (AssistantController). Inclus dans base.html.twig. #}
<style>
    .assistant-bouton { position: fixed; right: 20px; bottom: 20px; z-index: 1050; width: 58px; height: 58px; border-radius: 50%;
        border: none; background: var(--gradient); color: #000; font-size: 1.4rem; box-shadow: 0 8px 24px rgba(29,34,51,.25); cursor: pointer; }
    .assistant-panneau { position: fixed; right: 20px; bottom: 90px; z-index: 1050; width: 370px; max-width: calc(100vw - 32px);
        height: 520px; max-height: calc(100vh - 120px); background: var(--dark-card); border: 1px solid var(--border-color);
        border-radius: 14px; box-shadow: 0 16px 48px rgba(29,34,51,.22); display: flex; flex-direction: column; overflow: hidden; }
    .assistant-panneau[hidden] { display: none; }
    .assistant-entete { background: var(--gold); color: #fff; padding: .8rem 1rem; display: flex; align-items: center; justify-content: space-between; }
    .assistant-entete button { background: none; border: none; color: #fff; cursor: pointer; }
    .assistant-fil { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: .6rem; background: var(--dark-bg); }
    .assistant-msg { max-width: 85%; padding: .55rem .8rem; border-radius: 12px; font-size: .88rem; line-height: 1.45; white-space: pre-wrap; word-wrap: break-word; }
    .assistant-msg.bot { background: var(--dark-card); border: 1px solid var(--border-color); align-self: flex-start; color: var(--text-light); }
    .assistant-msg.moi { background: var(--gold); color: #fff; align-self: flex-end; }
    .assistant-msg.erreur { background: #fdecee; color: #842029; align-self: flex-start; }
    .assistant-msg a { color: var(--gold-dark); font-weight: 600; }
    .assistant-suggestions { display: flex; flex-wrap: wrap; gap: .4rem; }
    .assistant-suggestions button { font-size: .75rem; border: 1px solid var(--gold); color: var(--gold-dark); background: var(--dark-card); border-radius: 14px; padding: .25rem .6rem; cursor: pointer; }
    .assistant-saisie { display: flex; gap: .5rem; padding: .7rem; border-top: 1px solid var(--border-color); }
    .assistant-saisie input { flex: 1; border: 1px solid var(--border-color); border-radius: 20px; padding: .5rem .9rem; font-size: .88rem; background: var(--input-bg); color: var(--text-light); }
    .assistant-saisie input:focus { outline: none; border-color: var(--gold); }
    .assistant-saisie button { border: none; border-radius: 50%; width: 38px; height: 38px; background: var(--gold); color: #fff; cursor: pointer; }
    .assistant-saisie button:disabled { opacity: .5; cursor: default; }
</style>

<button type="button" class="assistant-bouton" id="assistant-ouvrir" aria-label="Ouvrir l'assistant" aria-controls="assistant-panneau" aria-expanded="false">
    <i class="fas fa-comments"></i>
</button>

<section class="assistant-panneau" id="assistant-panneau" role="dialog" aria-label="Assistant DreamTravel" hidden>
    <div class="assistant-entete">
        <div><i class="fas fa-robot me-2"></i><strong>Assistant DreamTravel</strong><div style="font-size:.7rem;opacity:.85">Réponses basées sur notre catalogue en temps réel</div></div>
        <div>
            <button type="button" id="assistant-reset" title="Nouvelle conversation"><i class="fas fa-redo"></i></button>
            <button type="button" id="assistant-fermer" title="Fermer"><i class="fas fa-times"></i></button>
        </div>
    </div>
    <div class="assistant-fil" id="assistant-fil" aria-live="polite">
        <div class="assistant-msg bot">Bonjour{{ app.user ? ' ' ~ app.user.prenom : '' }} ! Je peux vous aider à trouver un voyage, vérifier les places restantes ou expliquer le programme voucher.</div>
        <div class="assistant-suggestions" id="assistant-suggestions">
            <button type="button">Quels voyages pour moins de 1500 € ?</button>
            <button type="button">Combien de places reste-t-il pour Bali ?</button>
            <button type="button">Comment fonctionne le voucher ?</button>
        </div>
    </div>
    <form class="assistant-saisie" id="assistant-form">
        <input type="text" id="assistant-question" maxlength="500" placeholder="Votre question…" autocomplete="off" aria-label="Votre question">
        <button type="submit" id="assistant-envoyer" aria-label="Envoyer"><i class="fas fa-paper-plane"></i></button>
    </form>
</section>

<script>
(function () {
    const csrf = '{{ csrf_token('assistant') }}';
    const urlMessage = '{{ path('app_assistant_message') }}';
    const urlReset = '{{ path('app_assistant_reset') }}';
    const panneau = document.getElementById('assistant-panneau');
    const ouvrir = document.getElementById('assistant-ouvrir');
    const fil = document.getElementById('assistant-fil');
    const form = document.getElementById('assistant-form');
    const champ = document.getElementById('assistant-question');
    const envoyer = document.getElementById('assistant-envoyer');

    function basculer(afficher) {
        panneau.hidden = !afficher;
        ouvrir.setAttribute('aria-expanded', String(afficher));
        if (afficher) champ.focus();
    }
    ouvrir.addEventListener('click', () => basculer(panneau.hidden));
    document.getElementById('assistant-fermer').addEventListener('click', () => basculer(false));

    // Texte inséré sans HTML ; seuls les liens internes /voyages/{id} deviennent cliquables.
    function ajouter(texte, classe) {
        const bulle = document.createElement('div');
        bulle.className = 'assistant-msg ' + classe;
        texte.split(/(\/voyages\/\d+)/).forEach((morceau) => {
            if (/^\/voyages\/\d+$/.test(morceau)) {
                const a = document.createElement('a');
                a.href = morceau;
                a.textContent = 'Voir le voyage';
                bulle.appendChild(a);
            } else {
                bulle.appendChild(document.createTextNode(morceau));
            }
        });
        fil.appendChild(bulle);
        fil.scrollTop = fil.scrollHeight;
        return bulle;
    }

    async function poser(question) {
        document.getElementById('assistant-suggestions')?.remove();
        ajouter(question, 'moi');
        champ.value = '';
        envoyer.disabled = true;
        const attente = ajouter('…', 'bot');
        try {
            const r = await fetch(urlMessage, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
                body: JSON.stringify({ message: question }),
            });
            const data = await r.json();
            attente.remove();
            if (data.reponse) ajouter(data.reponse, 'bot');
            else ajouter(data.erreur || 'Erreur inattendue.', 'erreur');
        } catch (e) {
            attente.remove();
            ajouter('Connexion impossible. Réessayez.', 'erreur');
        } finally {
            envoyer.disabled = false;
            champ.focus();
        }
    }

    form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = champ.value.trim();
        if (q && !envoyer.disabled) poser(q);
    });
    document.querySelectorAll('#assistant-suggestions button').forEach((b) =>
        b.addEventListener('click', () => poser(b.textContent)));
    document.getElementById('assistant-reset').addEventListener('click', async () => {
        await fetch(urlReset, { method: 'POST', headers: { 'X-CSRF-Token': csrf } });
        fil.querySelectorAll('.assistant-msg').forEach((m, i) => { if (i > 0) m.remove(); });
    });
})();
</script>
