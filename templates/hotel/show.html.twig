{% extends 'base.html.twig' %}
{% block title %}{{ hotel.nom }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="mb-2 text-muted small">
                <a href="{{ path('app_voyages') }}" style="color:var(--text-muted);text-decoration:none">Voyages</a> / Hôtels
            </div>
            <h1 class="section-title mb-1">{{ hotel.nom }}</h1>
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="text-gold">
                    {% for i in 1..hotel.etoiles %}<i class="fas fa-star" style="font-size:.9rem"></i>{% endfor %}
                </div>
                <span class="text-muted small"><i class="fas fa-map-marker-alt me-1"></i>{{ hotel.adresse }}</span>
                {% if hotel.getNoteMoyenne() %}
                    <span class="badge badge-gold">{{ hotel.getNoteMoyenne() }}/5</span>
                {% endif %}
            </div>

            {% if hotel.photoPrincipale %}
                <img src="/uploads/{{ hotel.photoPrincipale }}" alt="{{ hotel.nom }}" class="w-100 rounded mb-4" style="height:320px;object-fit:cover">
            {% endif %}

            <h3 class="section-title mb-3">À propos de cet hôtel</h3>
            <p class="text-muted" style="line-height:1.8">{{ hotel.description }}</p>

            <!-- Avis -->
            {% set avisPublies = hotel.avis|filter(a => a.statut.value == 'publie') %}
            {% if avisPublies|length > 0 %}
            <h3 class="section-title mt-5 mb-4">Avis clients</h3>
            <div class="row g-3">
                {% for avi in avisPublies|slice(0,4) %}
                <div class="col-md-6">
                    <div style="background:var(--dark-card);border:1px solid var(--border-color);border-radius:8px;padding:1rem">
                        <div class="d-flex gap-1 mb-2">
                            {% for i in 1..5 %}
                                <i class="fas fa-star {{ i <= avi.note ? 'text-gold' : 'text-muted' }}" style="font-size:.75rem"></i>
                            {% endfor %}
                        </div>
                        <p class="text-muted small mb-2" style="font-style:italic">"{{ avi.commentaire }}"</p>
                        <div class="text-muted" style="font-size:.75rem">— {{ avi.client.nomComplet }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top:100px;background:var(--dark-card);border:1px solid var(--border-color);border-radius:12px;padding:2rem">
                <h5 style="font-family:'Playfair Display',serif;margin-bottom:1.5rem">Tarif</h5>
                <div class="text-center mb-4">
                    <div class="text-muted small text-uppercase" style="letter-spacing:1px">Prix par nuit</div>
                    <div class="text-gold" style="font-size:2rem;font-weight:700;font-family:'Playfair Display',serif">
                        {{ hotel.prixParNuit|number_format(0, ',', ' ') }} €
                    </div>
                </div>
                <div class="mb-3 small text-muted">
                    <div class="d-flex justify-content-between py-2" style="border-bottom:1px solid var(--border-color)">
                        <span><i class="fas fa-map-marker-alt text-gold me-2"></i>Destination</span>
                        <span>{{ hotel.destination.nom }}</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span><i class="fas fa-star text-gold me-2"></i>Catégorie</span>
                        <span>{{ hotel.etoiles }} étoiles</span>
                    </div>
                </div>
                <p class="text-muted small">Cet hôtel est disponible lors de vos réservations de voyage.</p>
                <a href="{{ path('app_voyages') }}" class="btn-outline-gold w-100 text-center" style="display:block;padding:.85rem">
                    <i class="fas fa-plane me-2"></i>Voir les voyages
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
