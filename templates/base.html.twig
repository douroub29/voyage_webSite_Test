<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}DreamTravel{% endblock %} — DreamTravel</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✈️</text></svg>">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        /* Thème clair. Les noms historiques (--dark-*, --text-light) sont conservés
           pour ne pas casser les templates : ils désignent fond / carte / texte principal. */
        :root {
            --dark-bg:      #f6f7fb;
            --dark-card:    #ffffff;
            --dark-nav:     #ffffff;
            --input-bg:     #ffffff;
            --gold:         #b8892d;
            --gold-light:   #d9b25a;
            --gold-dark:    #8a6420;
            --gold-soft:    rgba(184,137,45,0.12);
            --text-light:   #1d2233;
            --text-muted:   #6b7280;
            --border-color: #e4e7ef;
            --shadow-sm:    0 2px 12px rgba(29,34,51,0.06);
            --gradient:     linear-gradient(135deg, #c9a84c 0%, #e8c87a 50%, #c9a84c 100%);
        }
        .text-muted { color: var(--text-muted) !important; }

        * { box-sizing: border-box; }

        body {
            background-color: var(--dark-bg);
            color: var(--text-light);
            font-family: 'Raleway', sans-serif;
            font-weight: 400;
            min-height: 100vh;
        }

        h1, h2, h3, h4, h5, h6 { font-family: 'Playfair Display', serif; }

        /* ── NAVBAR ── */
        .navbar-dt {
            background: var(--dark-nav);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow-sm);
        }
        .navbar-brand-dt {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            color: var(--gold) !important;
            font-weight: 700;
            text-decoration: none;
            letter-spacing: 2px;
        }
        .navbar-brand-dt span { color: var(--text-light); }
        .nav-link-dt {
            color: var(--text-muted) !important;
            font-weight: 500;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.5rem 1rem !important;
            transition: color 0.3s;
            text-decoration: none;
        }
        .nav-link-dt:hover, .nav-link-dt.active { color: var(--gold) !important; }

        .btn-gold {
            background: var(--gradient);
            color: #000 !important;
            font-weight: 600;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 4px;
            letter-spacing: 1px;
            font-size: 0.85rem;
            text-transform: uppercase;
            transition: opacity 0.3s, transform 0.2s;
            text-decoration: none;
            display: inline-block;
        }
        .btn-gold:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn-outline-gold {
            border: 1px solid var(--gold);
            color: var(--gold) !important;
            background: transparent;
            padding: 0.55rem 1.4rem;
            border-radius: 4px;
            font-weight: 500;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }
        .btn-outline-gold:hover { background: var(--gold); color: #000 !important; }

        /* ── CARDS ── */
        .card-dt {
            background: var(--dark-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .card-dt:hover { transform: translateY(-5px); box-shadow: 0 12px 32px rgba(29,34,51,0.12); }
        .card-dt .card-img-top { height: 220px; object-fit: cover; }

        /* ── GOLD ACCENTS ── */
        .text-gold { color: var(--gold); }
        .text-gold-light { color: var(--gold-light); }
        .border-gold { border-color: var(--gold) !important; }
        .bg-dark-card { background: var(--dark-card); }

        .section-title {
            font-family: 'Playfair Display', serif;
            color: var(--text-light);
            position: relative;
            display: inline-block;
        }
        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 2px;
            background: var(--gradient);
            margin: 0.5rem 0 0;
        }
        .section-title.centered::after { margin: 0.5rem auto 0; }

        /* ── BADGES ── */
        .badge-gold { background: var(--gradient); color: #000; font-weight: 600; }
        .badge-warning  { background: #ffc107; color: #000; }
        .badge-success  { background: #198754; color: #fff; }
        .badge-danger   { background: #dc3545; color: #fff; }
        .badge-info     { background: #0dcaf0; color: #000; }

        /* ── FLASH MESSAGES ── */
        .flash-success { background: #e8f5ee; border-left: 3px solid #198754; color: #0f5132; }
        .flash-warning { background: #fff8e1; border-left: 3px solid #ffc107; color: #664d03; }
        .flash-danger  { background: #fdecee; border-left: 3px solid #dc3545; color: #842029; }
        .flash-info    { background: #e7f6fb; border-left: 3px solid #0dcaf0; color: #055160; }

        /* ── FORMS ── */
        .form-control-dt, .form-select-dt {
            background: var(--input-bg);
            border: 1px solid var(--border-color);
            color: var(--text-light);
            border-radius: 6px;
            padding: 0.7rem 1rem;
        }
        .form-control-dt:focus, .form-select-dt:focus {
            background: var(--input-bg);
            border-color: var(--gold);
            color: var(--text-light);
            box-shadow: 0 0 0 0.2rem rgba(201,168,76,0.15);
        }
        .form-control-dt::placeholder { color: var(--text-muted); }
        label.form-label { color: var(--text-muted); font-size: 0.85rem; letter-spacing: 0.5px; text-transform: uppercase; }

        /* ── FOOTER ── */
        .footer-dt {
            background: var(--dark-nav);
            border-top: 1px solid var(--border-color);
            padding: 3rem 0 1.5rem;
            margin-top: 5rem;
        }
        .footer-dt .footer-logo { font-family: 'Playfair Display', serif; color: var(--gold); font-size: 1.4rem; }
        .footer-dt a { color: var(--text-muted); text-decoration: none; transition: color 0.2s; }
        .footer-dt a:hover { color: var(--gold); }

        /* ── DIVIDER ── */
        .divider-gold { border: 0; border-top: 1px solid var(--border-color); margin: 2rem 0; }
        .divider-gold.accent { border-color: var(--gold-dark); }

        /* ── STARS ── */
        .stars .fa-star { color: #d1d5db; font-size: 0.85rem; }
        .stars .fa-star.filled { color: var(--gold); }

        /* ── SCROLL BAR ── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--dark-bg); }
        ::-webkit-scrollbar-thumb { background: #c9ccd6; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--gold-dark); }

        {% block extra_styles %}{% endblock %}
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar-dt">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <a href="{{ path('app_home') }}" class="navbar-brand-dt">Dream<span>Travel</span></a>

            <button class="navbar-toggler d-lg-none btn btn-sm" type="button" id="navToggle" style="border:1px solid var(--border-color);color:var(--text-light)">
                <i class="fas fa-bars"></i>
            </button>

            <div class="d-none d-lg-flex align-items-center gap-3" id="navMenu">
                <a href="{{ path('app_home') }}"    class="nav-link-dt {% if app.request.get('_route') == 'app_home' %}active{% endif %}">Accueil</a>
                <a href="{{ path('app_voyages') }}" class="nav-link-dt {% if app.request.get('_route') starts with 'app_voyage' %}active{% endif %}">Voyages</a>
                <a href="{{ path('app_planificateur') }}" class="nav-link-dt {% if app.request.get('_route') == 'app_planificateur' %}active{% endif %}"><i class="fas fa-magic me-1"></i>Voyage sur mesure</a>

                {% if app.user %}
                    {% if is_granted('ROLE_CLIENT') %}
                        <a href="{{ path('profil_reservations') }}" class="nav-link-dt {% if app.request.get('_route') starts with 'profil' %}active{% endif %}">Mes Réservations</a>
                        <a href="{{ path('profil_index') }}" class="nav-link-dt">Mon Compte</a>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_dashboard') }}" class="nav-link-dt" style="color:var(--gold)">
                            <i class="fas fa-cog me-1"></i>Administration
                        </a>
                    {% endif %}
                    <div class="d-flex align-items-center gap-2 ms-2">
                        <span class="text-gold" style="font-size:0.85rem">{{ app.user.prenom }}</span>
                        <a href="{{ path('app_logout') }}" class="btn-outline-gold" style="padding:0.4rem 0.9rem;font-size:0.78rem">Déconnexion</a>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}"    class="nav-link-dt">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn-gold" style="padding:0.5rem 1.2rem">Inscription</a>
                {% endif %}
            </div>
        </div>

        <!-- Mobile menu -->
        <div class="d-lg-none mt-3" id="mobileMenu" style="display:none!important">
            <div class="d-flex flex-column gap-2">
                <a href="{{ path('app_home') }}"    class="nav-link-dt">Accueil</a>
                <a href="{{ path('app_voyages') }}" class="nav-link-dt">Voyages</a>
                <a href="{{ path('app_planificateur') }}" class="nav-link-dt">Voyage sur mesure</a>
                {% if app.user %}
                    {% if is_granted('ROLE_CLIENT') %}
                        <a href="{{ path('profil_reservations') }}" class="nav-link-dt">Mes Réservations</a>
                        <a href="{{ path('profil_index') }}" class="nav-link-dt">Mon Compte</a>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_dashboard') }}" class="nav-link-dt" style="color:var(--gold)">Administration</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="nav-link-dt">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}"    class="nav-link-dt">Connexion</a>
                    <a href="{{ path('app_register') }}" class="nav-link-dt">Inscription</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<!-- FLASH MESSAGES -->
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash-{{ type }} p-3 mb-0">
            <div class="container d-flex align-items-center gap-2">
                <i class="fas {% if type == 'success' %}fa-check-circle{% elseif type == 'warning' %}fa-exclamation-triangle{% else %}fa-times-circle{% endif %}"></i>
                {{ message }}
            </div>
        </div>
    {% endfor %}
{% endfor %}

<!-- MAIN CONTENT -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- FOOTER -->
<footer class="footer-dt">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="footer-logo mb-2">DreamTravel</div>
                <p class="text-muted small">Votre agence de voyage d'excellence. Découvrez le monde avec style et confort.</p>
                <div class="d-flex gap-3 mt-3">
                    <a href="#"><i class="fab fa-facebook fa-lg"></i></a>
                    <a href="#"><i class="fab fa-instagram fa-lg"></i></a>
                    <a href="#"><i class="fab fa-twitter fa-lg"></i></a>
                    <a href="#"><i class="fab fa-linkedin fa-lg"></i></a>
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <h6 class="text-gold mb-3 text-uppercase" style="font-size:0.8rem;letter-spacing:2px">Navigation</h6>
                <ul class="list-unstyled small">
                    <li class="mb-1"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="mb-1"><a href="{{ path('app_voyages') }}">Voyages</a></li>
                    <li class="mb-1"><a href="{{ path('app_login') }}">Connexion</a></li>
                    <li class="mb-1"><a href="{{ path('app_register') }}">Inscription</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-4">
                <h6 class="text-gold mb-3 text-uppercase" style="font-size:0.8rem;letter-spacing:2px">Services</h6>
                <ul class="list-unstyled small">
                    <li class="mb-1"><a href="#">Voyages organisés</a></li>
                    <li class="mb-1"><a href="#">Hôtels de luxe</a></li>
                    <li class="mb-1"><a href="#">Transfert VIP</a></li>
                    <li class="mb-1"><a href="#">Assistance 24/7</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-4">
                <h6 class="text-gold mb-3 text-uppercase" style="font-size:0.8rem;letter-spacing:2px">Contact</h6>
                <ul class="list-unstyled small" style="color:var(--text-muted)">
                    <li class="mb-2"><i class="fas fa-envelope me-2 text-gold"></i>contact@dreamtravel.com</li>
                    <li class="mb-2"><i class="fas fa-phone me-2 text-gold"></i>+33 1 23 45 67 89</li>
                    <li class="mb-2"><i class="fas fa-map-marker-alt me-2 text-gold"></i>Paris, France</li>
                </ul>
            </div>
        </div>
        <hr class="divider-gold mt-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <p class="text-muted small mb-0">© {{ "now"|date("Y") }} DreamTravel. Tous droits réservés.</p>
            <p class="text-muted small mb-0">Fait avec <span class="text-gold">♥</span> pour les voyageurs</p>
        </div>
    </div>
</footer>

{% if not is_granted('ROLE_ADMIN') %}
    {{ include('_assistant.html.twig') }}
{% endif %}

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('navToggle')?.addEventListener('click', () => {
        const m = document.getElementById('mobileMenu');
        m.style.display = m.style.display === 'none' || !m.style.display ? 'block' : 'none';
    });
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
