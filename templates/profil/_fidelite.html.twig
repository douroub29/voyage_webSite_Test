{# Bloc programme de fidélité / voucher. Attend la variable `fidelite` (ProfilController::fidelite). #}
<div class="mb-4" style="background:var(--dark-card);border:1px solid {{ fidelite.eligible ? 'var(--gold)' : 'var(--border-color)' }};border-radius:12px;padding:1.5rem;box-shadow:var(--shadow-sm)">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h5 class="mb-1" style="font-family:'Playfair Display',serif">
                <i class="fas fa-ticket-alt text-gold me-2"></i>Voucher fidélité
            </h5>
            {% if fidelite.disponible %}
                <div class="small text-muted">
                    Vous avez un voucher <strong class="text-gold">-{{ fidelite.disponible.pourcentage }} %</strong>
                    ({{ fidelite.disponible.code }}) : il sera appliqué automatiquement à votre prochaine réservation.
                </div>
            {% elseif fidelite.eligible %}
                <div class="small text-muted">
                    Félicitations ! Avec {{ fidelite.confirmees }} réservations confirmées, vous avez droit à un voucher
                    <strong class="text-gold">-{{ fidelite.pourcentage }} %</strong> sur votre prochaine réservation.
                </div>
            {% else %}
                <div class="small text-muted">
                    Option réservée aux clients ayant <strong>{{ fidelite.seuil }} réservations confirmées</strong>.
                    Encore <strong>{{ fidelite.manquantes }}</strong> réservation(s) pour obtenir -{{ fidelite.pourcentage }} % sur la suivante.
                </div>
                {% set progression = (fidelite.confirmees % fidelite.seuil) / fidelite.seuil * 100 %}
                <div class="mt-2" style="height:6px;background:var(--border-color);border-radius:3px;max-width:320px">
                    <div style="height:6px;width:{{ progression }}%;background:var(--gradient);border-radius:3px"></div>
                </div>
                <div class="small text-muted mt-1">{{ fidelite.confirmees % fidelite.seuil }} / {{ fidelite.seuil }}</div>
            {% endif %}
        </div>

        {% if fidelite.eligible %}
            <a href="{{ path('profil_voucher') }}" class="btn-gold" target="_blank" style="padding:.7rem 1.4rem">
                <i class="fas fa-download me-1"></i>Télécharger voucher
            </a>
        {% endif %}
    </div>

    {% if fidelite.vouchers|length > 0 %}
        <div class="mt-3 pt-3 small" style="border-top:1px solid var(--border-color)">
            {% for v in fidelite.vouchers %}
                <div class="d-flex justify-content-between py-1">
                    <span><i class="fas fa-tag text-gold me-1"></i>{{ v.code }} · -{{ v.pourcentage }} % · émis le {{ v.createdAt|date('d/m/Y') }}</span>
                    {% if v.utilise %}
                        <span class="text-muted">Utilisé ({{ v.reservation.reference }})</span>
                    {% else %}
                        <span class="badge badge-success">Disponible</span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
