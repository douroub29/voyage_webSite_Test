{% extends 'base.html.twig' %}
{% block title %}Mon compte{% endblock %}

{% block body %}
<div class="container py-5" style="max-width:900px">
    <h1 class="section-title mb-4">Mon compte</h1>

    <div class="row g-4">
        <div class="col-md-4">
            <div style="background:var(--dark-card);border:1px solid var(--border-color);border-radius:12px;padding:2rem;text-align:center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:80px;height:80px;background:rgba(201,168,76,0.15);border:2px solid var(--gold);font-size:1.8rem;font-weight:700;color:var(--gold);font-family:'Playfair Display',serif">
                    {{ client.prenom|slice(0,1)|upper }}{{ client.nom|slice(0,1)|upper }}
                </div>
                <h4 style="font-family:'Playfair Display',serif">{{ client.nomComplet }}</h4>
                <p class="text-muted small mb-3">{{ client.email }}</p>
                <span class="badge badge-gold px-3 py-2">Client DreamTravel</span>
            </div>
        </div>

        <div class="col-md-8">
            <div style="background:var(--dark-card);border:1px solid var(--border-color);border-radius:12px;padding:2rem">
                <h5 class="text-gold mb-4 text-uppercase" style="font-size:.8rem;letter-spacing:2px">Informations personnelles</h5>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-muted small">Prénom</div>
                        <div>{{ client.prenom }}</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Nom</div>
                        <div>{{ client.nom }}</div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Email</div>
                        <div>{{ client.email }}</div>
                    </div>
                    {% if client.telephone %}
                    <div class="col-6">
                        <div class="text-muted small">Téléphone</div>
                        <div>{{ client.telephone }}</div>
                    </div>
                    {% endif %}
                    {% if client.dateNaissance %}
                    <div class="col-6">
                        <div class="text-muted small">Date de naissance</div>
                        <div>{{ client.dateNaissance|date('d/m/Y') }}</div>
                    </div>
                    {% endif %}
                    <div class="col-6">
                        <div class="text-muted small">Membre depuis</div>
                        <div>{{ client.createdAt|date('M Y') }}</div>
                    </div>
                </div>
            </div>

            <div style="background:var(--dark-card);border:1px solid var(--border-color);border-radius:12px;padding:1.5rem;margin-top:1rem">
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="text-gold" style="font-size:2rem;font-weight:700;font-family:'Playfair Display',serif">
                            {{ client.reservations|length }}
                        </div>
                        <div class="text-muted small">Réservations</div>
                    </div>
                    <div class="col-4">
                        <div class="text-gold" style="font-size:2rem;font-weight:700;font-family:'Playfair Display',serif">
                            {{ client.reservations|filter(r => r.statut.value == 'confirmee')|length }}
                        </div>
                        <div class="text-muted small">Confirmées</div>
                    </div>
                    <div class="col-4">
                        <div class="text-gold" style="font-size:2rem;font-weight:700;font-family:'Playfair Display',serif">
                            {{ client.avis|length }}
                        </div>
                        <div class="text-muted small">Avis</div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                {{ include('profil/_fidelite.html.twig') }}
            </div>

            <div class="mt-3 d-flex gap-3">
                <a href="{{ path('profil_reservations') }}" class="btn-gold" style="padding:.7rem 1.5rem">
                    <i class="fas fa-calendar-check me-2"></i>Mes réservations
                </a>
                <a href="{{ path('app_voyages') }}" class="btn-outline-gold" style="padding:.7rem 1.5rem">
                    <i class="fas fa-plane me-2"></i>Explorer les voyages
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
