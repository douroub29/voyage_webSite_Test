{# Fragment renvoyé par ProfilController::recommandations (chargé en différé). #}
{% if recommandations|length > 0 %}
    {% if voucherDisponible %}
        <div class="flash-success p-3 mb-3 rounded small">
            <i class="fas fa-ticket-alt me-1"></i>
            Votre voucher <strong>-{{ voucherDisponible.pourcentage }} %</strong> sera appliqué automatiquement sur le voyage que vous réserverez.
        </div>
    {% endif %}
    <div class="row g-4">
        {% for reco in recommandations %}
            {% set voyage = reco.voyage %}
            <div class="col-md-6 col-lg-4">
                <div class="card-dt h-100 d-flex flex-column">
                    <a href="{{ path('app_voyage_show', {id: voyage.id}) }}" style="display:block;height:170px;overflow:hidden">
                        {% if voyage.photoUrl %}
                            <img src="{{ voyage.photoUrl }}" alt="{{ voyage.titre }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
                        {% else %}
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background:var(--border-color)"><i class="fas fa-plane fa-2x text-gold"></i></div>
                        {% endif %}
                    </a>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="small text-muted mb-1"><i class="fas fa-map-marker-alt text-gold me-1"></i>{{ voyage.destination.nom }}, {{ voyage.destination.pays }} · {{ voyage.dateDepart|date('d/m/Y') }}</div>
                        <h6 style="color:var(--text-light)">{{ voyage.titre }}</h6>
                        <p class="small mb-3 flex-grow-1" style="color:var(--gold-dark)">
                            <i class="fas {{ reco.ia ? 'fa-magic' : 'fa-lightbulb' }} me-1"></i>{{ reco.raison }}
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-gold fw-bold">{{ voyage.prix|number_format(0, ',', ' ') }} €<span class="text-muted small fw-normal"> /pers.</span></span>
                            <a href="{{ path('app_voyage_show', {id: voyage.id}) }}" class="btn-gold" style="font-size:.75rem;padding:.45rem 1rem">Voir le détail</a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <p class="text-muted small mb-0">Aucune recommandation pour le moment : vous avez déjà réservé tous nos voyages disponibles !</p>
{% endif %}
