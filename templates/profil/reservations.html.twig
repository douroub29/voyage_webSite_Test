{% extends 'base.html.twig' %}
{% block title %}Mes réservations{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="section-title">Mes réservations</h1>
        <a href="{{ path('app_voyages') }}" class="btn-gold" style="padding:.6rem 1.2rem;font-size:.85rem">
            <i class="fas fa-plus me-1"></i>Nouvelle réservation
        </a>
    </div>

    {{ include('profil/_fidelite.html.twig') }}

    {% if gels is not empty %}
    <section class="mb-5">
        <h2 class="section-title" style="font-size:1.4rem">Mes prix gelés</h2>
        <div class="row g-3 mt-1">
            {% for gel in gels %}
                {% set statut = gel.utilise ? 'Utilisé' : (gel.expire ? 'Expiré' : 'Actif') %}
                <div class="col-md-6 col-lg-4">
                    <div style="background:var(--dark-card);border:1px solid {{ statut == 'Actif' ? '#4a90d9' : 'var(--border-color)' }};border-radius:10px;padding:1rem">
                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_voyage_show', {id: gel.voyage.id}) }}" class="fw-semibold">{{ gel.voyage.titre }}</a>
                            <span class="small fw-semibold" style="color:{{ statut == 'Actif' ? '#1f5f9e' : '#6c757d' }}"><i class="fas fa-snowflake me-1"></i>{{ statut }}</span>
                        </div>
                        <div class="small text-muted mt-1">
                            Gelé à <strong>{{ gel.prixGele|number_format(0, ',', ' ') }} €</strong> / pers. (prix actuel {{ gel.voyage.prix|number_format(0, ',', ' ') }} €)<br>
                            {% if statut == 'Actif' %}Expire le {{ gel.expireLe|date('d/m/Y à H:i') }}{% elseif statut == 'Utilisé' %}Réservation {{ gel.reservation.reference }}{% else %}Expiré le {{ gel.expireLe|date('d/m/Y') }}{% endif %}
                            · frais {{ gel.frais|number_format(2, ',', ' ') }} €
                        </div>
                        {% if statut == 'Actif' and gel.voyage.reservable %}
                            <a href="{{ path('reservation_nouvelle', {id: gel.voyage.id}) }}" class="btn-gold mt-2" style="font-size:.75rem;padding:.4rem .9rem">Réserver à ce prix</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {{ include('profil/_bloc_recommandations.html.twig', {classe: 'mb-5', taille: '1.4rem'}) }}

    {% if reservations|length == 0 %}
        <div class="text-center py-5" style="background:var(--dark-card);border:1px solid var(--border-color);border-radius:12px">
            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">Aucune réservation</h4>
            <p class="text-muted">Commencez par explorer nos voyages !</p>
            <a href="{{ path('app_voyages') }}" class="btn-gold mt-2" style="padding:.75rem 2rem">Voir les voyages</a>
        </div>
    {% else %}
        <div class="d-flex flex-column gap-3">
            {% for reservation in reservations %}
            <div style="background:var(--dark-card);border:1px solid var(--border-color);border-radius:12px;padding:1.5rem;
                        border-left:4px solid {{ reservation.statut.value == 'confirmee' ? '#198754' : reservation.statut.value == 'annulee' ? '#dc3545' : '#ffc107' }}">
                <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                        <div class="text-muted small mb-1">
                            <i class="fas fa-tag text-gold me-1"></i>{{ reservation.reference }}
                        </div>
                        <h5 style="color:var(--text-light);margin:0">{{ reservation.voyage.titre }}</h5>
                        <div class="text-muted small mt-1">
                            <i class="fas fa-map-marker-alt text-gold me-1"></i>
                            {{ reservation.voyage.destination.nom }}, {{ reservation.voyage.destination.pays }}
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Dates</div>
                        <div class="small">
                            {{ reservation.voyage.dateDepart|date('d/m/Y') }} → {{ reservation.voyage.dateRetour|date('d/m/Y') }}
                        </div>
                        <div class="text-muted small mt-1">{{ reservation.nombrePersonnes }} pers.</div>
                    </div>
                    <div class="col-md-2 text-center">
                        <span class="badge px-3 py-2
                            {{ reservation.statut.value == 'confirmee' ? 'badge-success' : reservation.statut.value == 'annulee' ? 'badge-danger' : 'badge-warning' }}">
                            {{ reservation.statut.label() }}
                        </span>
                    </div>
                    <div class="col-md-2 text-end">
                        <div class="text-gold fw-bold">{{ reservation.prixTotal|number_format(0,',','  ') }} €</div>
                        {% if reservation.voucher %}
                            <div class="small text-muted"><i class="fas fa-ticket-alt text-gold me-1"></i>-{{ reservation.voucher.pourcentage }} % appliqué</div>
                        {% endif %}
                        {% if reservation.statut.value == 'en_attente' %}
                            <a href="{{ path('reservation_recap', {id: reservation.id}) }}" class="btn-outline-gold mt-2" style="font-size:.75rem;padding:.35rem .8rem">
                                <i class="fas fa-credit-card me-1"></i>Payer
                            </a>
                        {% endif %}
                    </div>
                </div>

                {% if reservation.hotel or reservation.chauffeur %}
                <div class="d-flex gap-3 mt-3 pt-3 flex-wrap" style="border-top:1px solid var(--border-color)">
                    {% if reservation.hotel %}
                    <span class="small text-muted"><i class="fas fa-hotel text-gold me-1"></i>{{ reservation.hotel.nom }} ({{ reservation.nombreNuits }}n)</span>
                    {% endif %}
                    {% if reservation.chauffeur %}
                    <span class="small text-muted"><i class="fas fa-car text-gold me-1"></i>{{ reservation.chauffeur.nomComplet }}</span>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
