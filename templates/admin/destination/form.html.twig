{% extends 'admin/base.html.twig' %}
{% block title %}{{ titre }}{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-7">
        <div class="admin-card">
            <div class="admin-card-header">
                <h6 style="margin:0;font-weight:600">Informations de la destination</h6>
                <a href="{{ path('admin_destination_index') }}" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Retour
                </a>
            </div>
            <div class="admin-card-body">
                {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}
                    <div class="mb-3">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.pays) }}
                        {{ form_widget(form.pays, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.pays) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, {attr: {class: 'form-control', rows: 5}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                    <div class="row g-3 mb-3">
                        {% for champ in [form.latitude, form.longitude, form.codePays, form.dureeVolHeures] %}
                        <div class="col-md-3">
                            {{ form_label(champ) }}
                            {{ form_widget(champ, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(champ) }}
                        </div>
                        {% endfor %}
                        <div class="col-12 text-muted small mt-1">Utilisés pour la météo historique, les jours fériés et le planificateur par ambiance.</div>
                    </div>
                    <div class="mb-4">
                        {{ form_label(form.photoFile) }}
                        {{ form_widget(form.photoFile, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.photoFile) }}
                        {% if entity.photo %}
                            <div class="mt-2">
                                <img src="/uploads/{{ entity.photo }}" style="height:80px;border-radius:6px" alt="Photo actuelle">
                                <div class="text-muted small mt-1">Photo actuelle (sera remplacée si nouveau fichier sélectionné)</div>
                            </div>
                        {% endif %}
                    </div>
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-admin-primary px-4">
                            <i class="fas fa-save me-2"></i>Enregistrer
                        </button>
                        <a href="{{ path('admin_destination_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
