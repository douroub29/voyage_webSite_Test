{% extends 'admin/base.html.twig' %}
{% block title %}Clients{% endblock %}
{% block page_title %}Gestion des clients{% endblock %}

{% block body %}
<div class="admin-table">
    <div class="table-header">
        <h6 style="margin:0;font-size:.875rem;font-weight:600">{{ clients|length }} client(s)</h6>
    </div>
    <table class="table table-hover">
        <thead><tr><th>Client</th><th>Email</th><th>Téléphone</th><th>Réservations</th><th>Membre depuis</th><th>Actions</th></tr></thead>
        <tbody>
            {% for client in clients %}
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:38px;height:38px;background:#f0f2f8;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:.8rem;color:#666">
                            {{ client.prenom|slice(0,1)|upper }}{{ client.nom|slice(0,1)|upper }}
                        </div>
                        <div class="fw-500">{{ client.nomComplet }}</div>
                    </div>
                </td>
                <td class="text-muted">{{ client.email }}</td>
                <td class="text-muted">{{ client.telephone ?? '—' }}</td>
                <td><span class="badge bg-primary">{{ client.reservations|length }}</span></td>
                <td class="text-muted">{{ client.createdAt|date('d/m/Y') }}</td>
                <td>
                    <a href="{{ path('admin_client_show', {id: client.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="text-center text-muted py-4">Aucun client</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
