{% extends 'admin/base.html.twig' %}
{% block title %}{{ titre }}{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h6 style="margin:0;font-weight:600">Informations de la société</h6>
                <a href="{{ path('admin_societe_index') }}" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Retour
                </a>
            </div>
            <div class="admin-card-body">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    <div class="mb-4">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-admin-primary px-4">
                            <i class="fas fa-save me-2"></i>Enregistrer
                        </button>
                        <a href="{{ path('admin_societe_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
