{% extends 'admin/base.html.twig' %}
{% block title %}Sociétés{% endblock %}
{% block page_title %}Sociétés de voyage{% endblock %}

{% block body %}
<div class="admin-table">
    <div class="table-header">
        <h6 style="margin:0;font-size:.875rem;font-weight:600">{{ societes|length }} société(s)</h6>
        <a href="{{ path('admin_societe_new') }}" class="btn btn-sm btn-admin-primary">
            <i class="fas fa-plus me-1"></i>Nouvelle société
        </a>
    </div>
    <table class="table table-hover">
        <thead>
            <tr><th>Nom</th><th>Voyages</th><th>Actions</th></tr>
        </thead>
        <tbody>
            {% for societe in societes %}
            <tr>
                <td class="fw-500">{{ societe.nom }}</td>
                <td><span class="badge bg-primary">{{ societe.voyages|length }}</span></td>
                <td>
                    <div class="d-flex gap-2">
                        <a href="{{ path('admin_societe_edit', {id: societe.id}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form action="{{ path('admin_societe_delete', {id: societe.id}) }}" method="POST"
                              onsubmit="return confirm('Supprimer cette société ? Ses voyages seront conservés sans société.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ societe.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="3" class="text-center text-muted py-4">Aucune société</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
