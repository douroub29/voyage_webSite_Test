{% extends 'admin/base.html.twig' %}
{% block title %}{{ titre }}{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h6 style="margin:0;font-weight:600">Informations de l'hôtel</h6>
                <a href="{{ path('admin_hotel_index') }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Retour</a>
            </div>
            <div class="admin-card-body">
                {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}
                    <div class="mb-3">{{ form_label(form.nom) }}{{ form_widget(form.nom, {attr: {class: 'form-control'}}) }}{{ form_errors(form.nom) }}</div>
                    <div class="mb-3">{{ form_label(form.destination) }}{{ form_widget(form.destination, {attr: {class: 'form-select'}}) }}{{ form_errors(form.destination) }}</div>
                    <div class="mb-3">{{ form_label(form.adresse) }}{{ form_widget(form.adresse, {attr: {class: 'form-control'}}) }}{{ form_errors(form.adresse) }}</div>
                    <div class="mb-3">{{ form_label(form.description) }}{{ form_widget(form.description, {attr: {class: 'form-control', rows: 4}}) }}{{ form_errors(form.description) }}</div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">{{ form_label(form.prixParNuit) }}{{ form_widget(form.prixParNuit, {attr: {class: 'form-control'}}) }}{{ form_errors(form.prixParNuit) }}</div>
                        <div class="col-6">{{ form_label(form.etoiles) }}{{ form_widget(form.etoiles, {attr: {class: 'form-select'}}) }}{{ form_errors(form.etoiles) }}</div>
                    </div>
                    <div class="mb-3">{{ form_label(form.photoPrincipaleFile) }}{{ form_widget(form.photoPrincipaleFile, {attr: {class: 'form-control'}}) }}{{ form_errors(form.photoPrincipaleFile) }}</div>
                    <div class="mb-4"><div class="form-check">{{ form_widget(form.actif, {attr: {class: 'form-check-input'}}) }}{{ form_label(form.actif, null, {label_attr: {class: 'form-check-label'}}) }}</div></div>
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-admin-primary px-4"><i class="fas fa-save me-2"></i>Enregistrer</button>
                        <a href="{{ path('admin_hotel_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
