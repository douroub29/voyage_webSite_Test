{% extends 'admin/base.html.twig' %}
{% block title %}{{ titre }}{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h6 style="margin:0;font-weight:600">Informations du voyage</h6>
                <a href="{{ path('admin_voyage_index') }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Retour</a>
            </div>
            <div class="admin-card-body">
                {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}
                    <div class="mb-3">
                        {{ form_label(form.titre) }}
                        {{ form_widget(form.titre, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.titre) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.destination) }}
                        {{ form_widget(form.destination, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.destination) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.societe) }}
                        {{ form_widget(form.societe, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.societe) }}
                        <div class="form-text"><a href="{{ path('admin_societe_new') }}" target="_blank">+ Ajouter une société</a></div>
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, {attr: {class: 'form-control', rows: 4}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            {{ form_label(form.dateDepart) }}
                            {{ form_widget(form.dateDepart, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.dateDepart) }}
                        </div>
                        <div class="col-6">
                            {{ form_label(form.dateRetour) }}
                            {{ form_widget(form.dateRetour, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.dateRetour) }}
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            {{ form_label(form.prix) }}
                            {{ form_widget(form.prix, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.prix) }}
                        </div>
                        <div class="col-6">
                            {{ form_label(form.nombrePlaces) }}
                            {{ form_widget(form.nombrePlaces, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.nombrePlaces) }}
                            {{ form_help(form.nombrePlaces) }}
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            {{ form_label(form.compagnieAerienne) }}
                            {{ form_widget(form.compagnieAerienne, {attr: {class: 'form-select'}}) }}
                            {{ form_errors(form.compagnieAerienne) }}
                        </div>
                        <div class="col-6">
                            {{ form_label(form.numeroVol) }}
                            {{ form_widget(form.numeroVol, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.numeroVol) }}
                        </div>
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.photoFile) }}
                        {{ form_widget(form.photoFile, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.photoFile) }}
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            {{ form_widget(form.actif, {attr: {class: 'form-check-input'}}) }}
                            {{ form_label(form.actif, null, {label_attr: {class: 'form-check-label'}}) }}
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-admin-primary px-4"><i class="fas fa-save me-2"></i>Enregistrer</button>
                        <a href="{{ path('admin_voyage_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
