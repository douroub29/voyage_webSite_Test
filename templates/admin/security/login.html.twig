<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Administration — DreamTravel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #080818; min-height: 100vh; display: flex; align-items: center; }
        .login-card { background: #0f0f2a; border: 1px solid #1e1e4a; border-radius: 12px; padding: 2.5rem; max-width: 420px; width: 100%; }
        .form-control { background: #0a0a22 !important; border: 1px solid #1e1e4a !important; color: #e8e8f2 !important; padding: .75rem 1rem; border-radius: 6px; }
        .form-control:focus { border-color: #c9a84c !important; box-shadow: 0 0 0 .15rem rgba(201,168,76,.2) !important; }
        .btn-gold { background: linear-gradient(135deg,#c9a84c,#f0d080,#c9a84c); color: #000; font-weight: 600; border: none; padding: .85rem; border-radius: 6px; width: 100%; cursor: pointer; font-size: .95rem; letter-spacing: 1px; }
    </style>
</head>
<body>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="login-card mx-auto">
                <div class="text-center mb-4">
                    <div style="font-family:'Playfair Display',serif;font-size:1.5rem;color:#c9a84c;letter-spacing:2px">DreamTravel</div>
                    <div style="font-size:.7rem;color:#555580;letter-spacing:2px;text-transform:uppercase;margin-top:4px">Administration</div>
                    <div style="width:40px;height:2px;background:linear-gradient(135deg,#c9a84c,#f0d080);margin:.8rem auto 0"></div>
                </div>

                <h5 style="color:#e8e8f2;text-align:center;margin-bottom:1.5rem">Connexion Administrateur</h5>

                {% if error %}
                    <div style="background:rgba(220,53,69,.1);border-left:3px solid #dc3545;color:#ea868f;padding:.875rem 1rem;border-radius:4px;margin-bottom:1rem;font-size:.875rem">
                        <i class="fas fa-exclamation-circle me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form action="{{ path('admin_login') }}" method="POST">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <div class="mb-3">
                        <label style="color:#8080aa;font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:.4rem">Email</label>
                        <input type="email" name="email" value="{{ last_username }}" required autofocus class="form-control" placeholder="admin@dreamtravel.com">
                    </div>
                    <div class="mb-4">
                        <label style="color:#8080aa;font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:.4rem">Mot de passe</label>
                        <input type="password" name="password" required class="form-control" placeholder="••••••••">
                    </div>
                    <button type="submit" class="btn-gold"><i class="fas fa-shield-alt me-2"></i>Accéder au tableau de bord</button>
                </form>

                <div style="text-align:center;margin-top:1.5rem">
                    <a href="{{ path('app_home') }}" style="color:#555580;font-size:.8rem;text-decoration:none">
                        <i class="fas fa-arrow-left me-1"></i>Retour au site
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
