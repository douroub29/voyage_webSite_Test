{% extends 'base.html.twig' %}
{% block title %}Vérifiez votre email{% endblock %}

{% block extra_styles %}
.check-card {
    max-width: 540px;
    margin: 5rem auto;
    background: var(--dark-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 3rem 2.5rem;
    text-align: center;
}
.icon-mail {
    width: 88px; height: 88px;
    background: rgba(201,168,76,.1);
    border: 2px solid var(--gold);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.8rem;
    font-size: 2rem;
}
.step {
    display: flex; align-items: flex-start; gap: 1rem;
    background: var(--dark-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: .9rem 1.1rem;
    margin-bottom: .65rem;
    text-align: left;
}
.step-num {
    width: 26px; height: 26px; min-width: 26px;
    background: var(--gradient);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: .78rem; color: #000;
}
{% endblock %}

{% block body %}
<div class="container py-4">
<div class="check-card">

    <div class="icon-mail">
        <i class="fas fa-envelope-open-text text-gold"></i>
    </div>

    <h2 class="section-title centered mb-2" style="font-size:1.5rem">
        Vérifiez votre boîte email
    </h2>
    <p class="text-muted mb-4" style="font-size:.92rem;line-height:1.7">
        Un email d'activation vient d'être envoyé.<br>
        Cliquez sur le lien dans l'email pour activer votre compte.
    </p>

    <div class="mb-4">
        <div class="step">
            <div class="step-num">1</div>
            <div>
                <div style="color:var(--text-light);font-weight:600;font-size:.88rem">Ouvrez votre messagerie</div>
                <div class="text-muted" style="font-size:.8rem">Vérifiez aussi le dossier <em>Spam / Indésirables</em></div>
            </div>
        </div>
        <div class="step">
            <div class="step-num">2</div>
            <div>
                <div style="color:var(--text-light);font-weight:600;font-size:.88rem">Trouvez l'email DreamTravel</div>
                <div class="text-muted" style="font-size:.8rem">Objet : <em>Activation de votre compte DreamTravel</em></div>
            </div>
        </div>
        <div class="step">
            <div class="step-num">3</div>
            <div>
                <div style="color:var(--text-light);font-weight:600;font-size:.88rem">Cliquez sur « Activer mon compte »</div>
                <div class="text-muted" style="font-size:.8rem">Vous serez redirigé vers la page de connexion</div>
            </div>
        </div>
    </div>

    <hr class="divider-gold">

    <p class="text-muted" style="font-size:.83rem;margin-bottom:.9rem">Vous n'avez pas reçu l'email ?</p>

    <form action="{{ path('app_resend_verification') }}" method="POST" class="d-flex gap-2 justify-content-center flex-wrap">
        <input type="email" name="email" placeholder="Votre adresse email" required
               style="background:var(--input-bg);border:1px solid var(--border-color);color:var(--text-light);
                      border-radius:6px;padding:.6rem 1rem;font-size:.85rem;max-width:250px;width:100%">
        <button type="submit" class="btn-outline-gold"
                style="border:none;cursor:pointer;padding:.6rem 1.1rem;font-size:.82rem">
            <i class="fas fa-paper-plane me-1"></i>Renvoyer
        </button>
    </form>

    <div class="mt-4">
        <a href="{{ path('app_login') }}" style="color:var(--text-muted);font-size:.82rem">
            <i class="fas fa-arrow-left me-1"></i>Retour à la connexion
        </a>
    </div>

</div>
</div>
{% endblock %}
