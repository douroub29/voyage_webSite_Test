{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}

{% block extra_styles %}
.auth-wrapper { min-height: 90vh; display: flex; align-items: center; background: radial-gradient(ellipse at center, var(--dark-card) 0%, var(--dark-bg) 70%); }
.auth-card { background: var(--dark-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 2.5rem; max-width: 440px; width: 100%; }
{% endblock %}

{% block body %}
<div class="auth-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="auth-card mx-auto">
                    <div class="text-center mb-4">
                        <div class="text-gold mb-2" style="font-size:2rem">✈</div>
                        <h2 style="font-family:'Playfair Display',serif">Connexion</h2>
                        <p class="text-muted small">Bienvenue chez DreamTravel</p>
                    </div>

                    {% if error %}
                        <div class="flash-danger p-3 rounded mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form action="{{ path('app_login') }}" method="POST">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="mb-3">
                            <label class="form-label">Adresse email</label>
                            <input type="email" name="email" value="{{ last_username }}" required autofocus
                                   class="form-control" style="background:var(--input-bg);border:1px solid var(--border-color);color:var(--text-light);padding:.75rem 1rem;border-radius:6px"
                                   placeholder="votre@email.com">
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Mot de passe</label>
                            <input type="password" name="password" required
                                   class="form-control" style="background:var(--input-bg);border:1px solid var(--border-color);color:var(--text-light);padding:.75rem 1rem;border-radius:6px"
                                   placeholder="••••••••">
                        </div>
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <label class="d-flex align-items-center gap-2 text-muted small" style="cursor:pointer">
                                <input type="checkbox" name="_remember_me"> Se souvenir de moi
                            </label>
                        </div>
                        <button type="submit" class="btn-gold w-100 text-center" style="display:block;padding:.85rem;font-size:.95rem">
                            <i class="fas fa-sign-in-alt me-2"></i>Se connecter
                        </button>
                    </form>

                    <hr class="divider-gold mt-4">
                    <p class="text-center text-muted small mb-0">
                        Pas encore de compte ?
                        <a href="{{ path('app_register') }}" class="text-gold">Créer un compte</a>
                    </p>
                    <p class="text-center small mt-2">
                        <a href="{{ path('admin_login') }}" class="text-muted" style="font-size:0.78rem">Espace Administrateur</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
