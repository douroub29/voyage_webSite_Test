{# Conteneur "Ce qui vous attend sur place" : charge voyage/_contexte.html.twig en différé (API externes + IA). #}
<style>
.ctx-card { background:var(--dark-card); border:1px solid var(--border-color); border-radius:10px; padding:1.1rem 1.25rem; }
.ctx-label { font-size:.72rem; text-transform:uppercase; letter-spacing:.6px; color:var(--text-muted, #6c757d); font-weight:600; }
.ctx-valeur { font-family:'Playfair Display',serif; font-size:1.5rem; color:var(--text-light); line-height:1.2; }
.ctx-barre { height:6px; background:var(--border-color); border-radius:3px; overflow:hidden; }
.ctx-barre span { display:block; height:100%; border-radius:3px; }
.ctx-source { font-size:.7rem; color:#9aa0ac; margin-top:.75rem; }
.badge-ctx { display:inline-block; background:var(--gold-soft); color:var(--gold-dark); border-radius:4px; padding:.05rem .4rem; font-weight:600; font-size:.75rem; }
</style>
<div class="contexte-sejour" data-url="{{ path('app_voyage_contexte', {id: voyage.id}) }}">
    <div class="text-muted small"><i class="fas fa-spinner fa-spin me-2 text-gold"></i>Analyse de la météo, de l'affluence et des événements à ces dates…</div>
</div>
<script>
(function () {
    document.querySelectorAll('.contexte-sejour:not([data-charge])').forEach((zone) => {
        zone.dataset.charge = '1';
        fetch(zone.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then((r) => r.ok ? r.text() : Promise.reject())
            .then((html) => { zone.innerHTML = html; })
            .catch(() => { zone.innerHTML = '<p class="small text-muted mb-0">Informations sur place momentanément indisponibles.</p>'; });
    });
})();
</script>
