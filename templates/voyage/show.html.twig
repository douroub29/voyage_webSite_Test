{% extends 'base.html.twig' %}
{% block title %}{{ voyage.titre }}{% endblock %}

{% block extra_styles %}
.voyage-hero { position:relative; height:420px; overflow:hidden; }
.voyage-hero img { width:100%; height:100%; object-fit:cover; filter:brightness(.5); }
.voyage-hero-overlay { position:absolute; inset:0; display:flex; align-items:flex-end; padding:2.5rem; color:#fff; }
.voyage-hero-overlay .crumb, .voyage-hero-overlay .crumb a { color:rgba(255,255,255,.8); }
.hotel-mini-card { background:var(--dark-card); border:1px solid var(--border-color); border-radius:8px; padding:1rem; transition:border-color .2s; cursor:pointer; }
.hotel-mini-card:hover { border-color:var(--gold); }
.hotel-mini-card img { width:60px; height:60px; object-fit:cover; border-radius:6px; }
{% endblock %}

{% block body %}

<!-- HERO IMAGE -->
<div class="voyage-hero">
    {% if voyage.photoUrl %}
        <img src="{{ voyage.photoUrl }}" alt="{{ voyage.titre }}">
    {% else %}
        <div style="height:420px;background:linear-gradient(135deg,#1d2a44,#3a4a6b)"></div>
    {% endif %}
    <div class="voyage-hero-overlay">
        <div>
            <div class="crumb small mb-1">
                <a href="{{ path('app_voyages') }}" style="text-decoration:none">Voyages</a>
                <span class="mx-2">/</span>{{ voyage.destination.nom }}
            </div>
            <h1 style="font-family:'Playfair Display',serif;font-size:2.5rem;margin:0;color:#fff">{{ voyage.titre }}</h1>
            {% if voyage.societe %}
                <div class="mt-2" style="color:rgba(255,255,255,.85)"><i class="fas fa-building me-1"></i>Organisé par <strong>{{ voyage.societe.nom }}</strong></div>
            {% endif %}
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">

        <!-- DETAILS VOYAGE -->
        <div class="col-lg-8">
            <!-- Infos rapides -->
            <div class="row g-3 mb-4">
                {% for item in [
                    {icon:'fa-map-marker-alt', label:'Destination', val: voyage.destination.nom ~ ', ' ~ voyage.destination.pays},
                    {icon:'fa-calendar',       label:'Départ',      val: voyage.dateDepart|date('d/m/Y')},
                    {icon:'fa-calendar-check', label:'Retour',      val: voyage.dateRetour|date('d/m/Y')},
                    {icon:'fa-clock',          label:'Durée',       val: voyage.getDureeJours() ~ ' jours'},
                    {icon:'fa-users',          label:'Places',      val: voyage.getPlacesRestantes() ~ ' / ' ~ voyage.nombrePlaces ~ ' restantes'},
                    {icon:'fa-building',       label:'Société',     val: voyage.societe ? voyage.societe.nom : '—'},
                    {icon:'fa-plane',          label:'Vol',         val: (voyage.compagnieAerienne ? voyage.compagnieAerienne.label : '—') ~ (voyage.numeroVol ? ' · ' ~ voyage.numeroVol : '')},
                ] %}
                <div class="col-6 col-md-4">
                    <div class="d-flex align-items-center gap-2 p-3 rounded" style="background:var(--dark-card);border:1px solid var(--border-color)">
                        <i class="fas {{ item.icon }} text-gold"></i>
                        <div>
                            <div class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.5px">{{ item.label }}</div>
                            <div style="font-size:.9rem;color:var(--text-light);font-weight:500">{{ item.val }}</div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <!-- Description -->
            <h3 class="section-title mb-3">Description</h3>
            <p class="text-muted" style="line-height:1.8">{{ voyage.description }}</p>

            <!-- Hôtels disponibles -->
            {% if hotels|length > 0 %}
            <h3 class="section-title mt-5 mb-3">Hôtels disponibles</h3>
            <div class="row g-3">
                {% for hotel in hotels %}
                <div class="col-md-6">
                    <a href="{{ path('app_hotel_show', {id: hotel.id}) }}" style="text-decoration:none">
                        <div class="hotel-mini-card d-flex gap-3 align-items-center">
                            {% if hotel.photoPrincipale %}
                                <img src="/uploads/{{ hotel.photoPrincipale }}" alt="{{ hotel.nom }}">
                            {% else %}
                                <div style="width:60px;height:60px;background:var(--border-color);border-radius:6px;display:flex;align-items:center;justify-content:center">
                                    <i class="fas fa-hotel text-gold"></i>
                                </div>
                            {% endif %}
                            <div>
                                <div style="color:var(--text-light);font-weight:500">{{ hotel.nom }}</div>
                                <div class="text-gold" style="font-size:.8rem">
                                    {% for i in 1..hotel.etoiles %}<i class="fas fa-star" style="font-size:.65rem"></i>{% endfor %}
                                </div>
                                <div class="text-muted small">{{ hotel.prixParNuit|number_format(0, ',', ' ') }} €/nuit</div>
                            </div>
                        </div>
                    </a>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <!-- SIDEBAR BOOKING -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top:100px">
                <div style="background:var(--dark-card);border:1px solid var(--border-color);border-radius:12px;padding:2rem">
                    <div class="text-center mb-4">
                        <div class="text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:1px">Prix par personne</div>
                        <div class="text-gold" style="font-size:2.5rem;font-weight:700;font-family:'Playfair Display',serif">
                            {{ voyage.prix|number_format(0, ',', ' ') }} €
                        </div>
                    </div>

                    {% if voyage.reservable %}
                        {% if is_granted('ROLE_CLIENT') %}
                            <a href="{{ path('reservation_nouvelle', {id: voyage.id}) }}" class="btn-gold w-100 text-center" style="display:block;padding:1rem;font-size:1rem">
                                <i class="fas fa-calendar-plus me-2"></i>Réserver maintenant
                            </a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn-gold w-100 text-center" style="display:block;padding:1rem;font-size:1rem">
                                <i class="fas fa-sign-in-alt me-2"></i>Connectez-vous pour réserver
                            </a>
                        {% endif %}
                    {% else %}
                        <div class="text-center p-3 rounded" style="background:rgba(220,53,69,.08);border:1px solid #dc3545;color:#b02a37">
                            <i class="fas fa-ban me-2"></i>{{ voyage.motifNonReservable }}
                        </div>
                    {% endif %}

                    <div class="mt-4 small text-muted">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fas fa-check-circle text-gold"></i> Annulation flexible
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fas fa-check-circle text-gold"></i> Paiement sécurisé
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-check-circle text-gold"></i> Voucher immédiat
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
