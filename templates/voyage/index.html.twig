{% extends 'base.html.twig' %}
{% block title %}Voyages{% endblock %}

{% block extra_styles %}
.filter-bar { background: var(--dark-card); border: 1px solid var(--border-color); border-radius: 10px; padding: 1.5rem; box-shadow: var(--shadow-sm); }
.filter-bar input, .filter-bar select { background: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-light); border-radius: 6px; padding: .65rem 1rem; width: 100%; }
.filter-bar input:focus, .filter-bar select:focus { border-color: var(--gold); outline: none; box-shadow: 0 0 0 .15rem var(--gold-soft); }
.voyage-card { display: flex; flex-direction: column; }
.voyage-card .voyage-img { height: 210px; object-fit: cover; width: 100%; display: block; }
.voyage-card .voyage-body { padding: 1.5rem; display: flex; flex-direction: column; flex: 1 1 auto; }
.societe-tag { font-size: .75rem; color: var(--gold-dark); background: var(--gold-soft); border-radius: 20px; padding: .2rem .7rem; display: inline-block; }
{% endblock %}

{% block body %}
<div class="container" style="padding-top:3rem;padding-bottom:4rem">
    <div class="mb-4">
        <h1 class="section-title">Nos Voyages</h1>
        <p class="text-muted">Trouvez le voyage de vos rêves</p>
    </div>

    <!-- FILTRES -->
    <form action="{{ path('app_voyages') }}" method="GET" class="filter-bar mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-6 col-lg-3">
                <label class="form-label">Destination / Pays</label>
                <input type="text" name="destination" value="{{ destination ?? '' }}" placeholder="Ex: Paris, Maroc...">
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label">Société de voyage</label>
                <input type="text" name="societe" value="{{ societe ?? '' }}" placeholder="Nom de la société" list="societes-list" autocomplete="off">
                <datalist id="societes-list">
                    {% for s in societes %}<option value="{{ s.nom }}">{% endfor %}
                </datalist>
            </div>
            <div class="col-md-4 col-lg-2">
                <label class="form-label">Date de départ</label>
                <input type="date" name="date_depart" value="{{ dateDepart ? dateDepart|date('Y-m-d') : '' }}">
            </div>
            <div class="col-md-4 col-lg-2">
                <label class="form-label">Budget max (€)</label>
                <input type="number" name="budget" value="{{ budget ?? '' }}" placeholder="Ex: 2000">
            </div>
            <div class="col-md-4 col-lg-2">
                <button type="submit" class="btn-gold w-100 text-center" style="display:block;padding:.7rem">
                    <i class="fas fa-search"></i> Filtrer
                </button>
            </div>
        </div>
        {% if destination or societe or dateDepart or budget %}
            <div class="mt-3 small">
                <a href="{{ path('app_voyages') }}" class="text-gold" style="text-decoration:none"><i class="fas fa-times me-1"></i>Effacer les filtres</a>
            </div>
        {% endif %}
    </form>

    {% if voyages|length == 0 %}
        <div class="text-center py-5">
            <i class="fas fa-plane-slash fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">Aucun voyage trouvé</h4>
            <p class="text-muted">Essayez d'autres critères de recherche.</p>
            <a href="{{ path('app_voyages') }}" class="btn-outline-gold mt-2">Réinitialiser</a>
        </div>
    {% else %}
        <p class="text-muted small mb-3">{{ voyages|length }} voyage(s) trouvé(s)</p>
        <div class="row g-4">
            {% for voyage in voyages %}
            <div class="col-md-6 col-lg-4">
                <div class="card-dt voyage-card h-100">
                    <a href="{{ path('app_voyage_show', {id: voyage.id}) }}">
                        {% if voyage.photoUrl %}
                            <img src="{{ voyage.photoUrl }}" alt="{{ voyage.titre }}" class="voyage-img">
                        {% else %}
                            <div class="voyage-img d-flex align-items-center justify-content-center" style="background:var(--border-color)">
                                <i class="fas fa-plane fa-2x text-gold"></i>
                            </div>
                        {% endif %}
                    </a>
                    <div class="voyage-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted"><i class="fas fa-map-marker-alt text-gold me-1"></i>{{ voyage.destination.nom }}, {{ voyage.destination.pays }}</span>
                            <span class="badge badge-gold">{{ voyage.getDureeJours() }} jours</span>
                        </div>
                        <h5 style="color:var(--text-light)" class="mb-2">{{ voyage.titre }}</h5>
                        {% if voyage.societe %}
                            <div class="mb-2"><span class="societe-tag"><i class="fas fa-building me-1"></i>{{ voyage.societe.nom }}</span></div>
                        {% endif %}
                        <p class="text-muted small flex-grow-1" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
                            {{ voyage.description }}
                        </p>
                        <div class="row g-2 my-3 small text-muted">
                            <div class="col-6"><i class="fas fa-calendar text-gold me-1"></i> {{ voyage.dateDepart|date('d/m/Y') }}</div>
                            <div class="col-6"><i class="fas fa-users text-gold me-1"></i> {{ voyage.getPlacesRestantes() }} places</div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3" style="border-top:1px solid var(--border-color)">
                            <div>
                                <div class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:1px">À partir de</div>
                                <div class="text-gold" style="font-size:1.3rem;font-weight:700;font-family:'Playfair Display',serif">{{ voyage.prix|number_format(0, ',', ' ') }} €</div>
                            </div>
                            <a href="{{ path('app_voyage_show', {id: voyage.id}) }}" class="btn-gold" style="font-size:.8rem;padding:.55rem 1.2rem">
                                <i class="fas fa-eye me-1"></i>Voir le détail
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
